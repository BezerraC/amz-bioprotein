<!-- Hero Section -->
<div class="container-md pt-0 pt-sm-4 position-relative" >
  <div id="heroVidPosition" class="amz-bg-primary amz-br amz-secondary amz-vh d-flex justify-content-center align-items-center">
    <!-- Video de fundo -->
    <video autoplay playsinline muted loop id="heroVideo" preload="auto" class="position-absolute amz-vh" style="object-fit: cover;">
      <source src="/img/hero_video.mp4" type="video/mp4">
      Seu navegador não suporta vídeos.
    </video>
    
    <!-- Sobreposição verde -->
    <div class="overlay position-absolute amz-vh"></div>
    
    <!-- Conteúdo do Hero -->
    <div id="heroLogo" class="text-center position-relative">
      <p class="amz-p mb-0">Esse é o futuro</p>
      <h1 class="h1-black">Nutrição para todos</h1>
      <h1 class="h1-light">sem sacrificar o planeta</h1>
      <p class="amz-p">Para todos que buscam uma vida mais saudável e sustentável</p>
      <a href="#contact" class="mt-5 btn amz-btn-primary amz-bg-secondary amz-primary">Entre em contato</a>
    </div>
  </div>
</div>



<!-- About Section-->
<div id="about" class="carousel slide container-md pt-4 mt-5 mb-5" data-bs-ride="carousel">
  <p class="amz-primary amz-p mb-3 mb-sm-5 text-center">Conheça nossa história</p>
  <div class="carousel-inner">
    <!-- Slide 1 -->
    <div class="carousel-item active">
      <div class="row flex-sm-row flex-column">
        <div class="col">
          <img class="w-100" src="/img/abouImg.svg" alt="Sobre nós - Imagem 1" />
        </div>
        <div class="col-2 d-none d-sm-flex justify-content-center">
          <div class="vr amz-bg-primary h-100"></div>
        </div>
        <div class="col">
          <h1 class="amz-primary h1-black">Quem somos</h1>
          <p class="amz-primary amz-p">A Amazon Bioprotein é uma startup dedicada a transformar o mercado de suplementação proteica, oferecendo alternativas de alta qualidade que respeitam o meio ambiente. Nosso compromisso é com a sustentabilidade e a saúde, criando produtos que atendam às necessidades dos consumidores. Com sede em Macapá, focamos especialmente no mercado sênior, desenvolvendo soluções nutricionais que promovem uma vida saudável e ativo, ao mesmo tempo em que protegemos a floresta Amazônica.</p>
          <a href="#contact" class="mt-3 btn amz-btn-primary amz-bg-primary amz-secondary amz-p">Entre em contato</a>
        </div>
      </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-item">
      <div class="row flex-sm-row flex-column">
        <div class="col">
          <img class="w-100" src="/img/abouImg2.svg" alt="Sobre nós - Imagem 2" />
        </div>
        <div class="col-2 d-none d-sm-flex justify-content-center">
          <div class="vr amz-bg-primary h-100"></div>
        </div>
        <div class="col">
          <h1 class="amz-primary h1-black">Nossa Missão</h1>
          <p class="amz-primary amz-p">Nossa missão é criar alternativas inovadoras de suplementação proteica vegetal, utilizando o cariru, uma planta da Amazônia reconhecida por suas ricas propriedades nutricionais. Nosso compromisso é desenvolver soluções que respeitem o meio ambiente, atendendo às necessidades nutricionais de nossos consumidores, especialmente do mercado sênior. Assim, contribuímos para a saúde e bem-estar de todos, garantindo que sustentabilidade e inovação caminhem juntas.</p>
          <a href="#contact" class="mt-3 btn amz-btn-primary amz-bg-primary amz-secondary amz-p">Entre em contato</a>
        </div>
      </div>
    </div>

    <!-- Slide 3 -->
    <div class="carousel-item">
      <div class="row flex-sm-row flex-column">
        <div class="col">
          <img class="w-100" src="/img/abouImg4.svg" alt="Sobre nós - Imagem 3" />
        </div>
        <div class="col-2 d-none d-sm-flex justify-content-center">
          <div class="vr amz-bg-primary h-100"></div>
        </div>
        <div class="col">
          <h1 class="amz-primary h1-black">Nossos Valores</h1>
          <p class="amz-primary amz-p">Valorizamos profundamente a sustentabilidade, a inovação e a saúde em todas as nossas ações. Nosso compromisso é oferecer produtos que auxiliem os consumidores a atingir um estilo de vida mais saudável, com foco em nutrição de qualidade e preservação ambiental. Ao mesmo tempo, protegemos a biodiversidade da floresta Amazônica, proporcionando uma conexão entre as necessidades humanas e o respeito à natureza, com o objetivo de promover um futuro mais equilibrado.</p>
          <a href="#contact" class="mt-3 btn amz-btn-primary amz-bg-primary amz-secondary amz-p">Entre em contato</a>
        </div>
      </div>
    </div>


    <!-- Slide 4 -->
    <div class="carousel-item">
      <div class="row flex-sm-row flex-column">
        <div class="col">
          <img class="w-100" src="/img/abouImg3.svg" alt="Sobre nós - Imagem 4" />
        </div>
        <div class="col-2 d-none d-sm-flex justify-content-center">
          <div class="vr amz-bg-primary h-100"></div>
        </div>
        <div class="col">
          <h1 class="amz-primary h1-black">Nossa CEO</h1>
          <p class="amz-primary amz-p">Antonia Maria Bezerra, 76 anos, é nutricionista e fundadora da Amazon Bioprotein. Com vasta experiência em nutrição e empreendedorismo, ela é uma defensora apaixonada por soluções sustentáveis e inovadoras que valorizam o meio ambiente e a saúde humana. Sua liderança inspira nossa missão de transformar a suplementação proteica no Brasil, promovendo uma visão de futuro saudável para todas as gerações, com foco em sustentabilidade e qualidade de vida.</p>
          <a href="#contact" class="mt-3 btn amz-btn-primary amz-bg-primary amz-secondary amz-p">Entre em contato</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Controls (Bolinhas) -->
  <div class="carousel-indicators">
    <button type="button" data-bs-target="#about" data-bs-slide-to="0" class="active" aria-current="true"></button>
    <button type="button" data-bs-target="#about" data-bs-slide-to="1"></button>
    <button type="button" data-bs-target="#about" data-bs-slide-to="2"></button>
    <button type="button" data-bs-target="#about" data-bs-slide-to="3"></button>
  </div>
</div>


<!-- Feature Section-->
<div class="amz-bg-primary" id="feature">
  <div class="container-md py-5 mt-5">
    <div class="text-center amz-secondary mb-3">
      <h1 class="h1-black">Atribuindo valores</h1>
      <h1 class="h1-light">para a floresta Amazônica</h1>
      <p class="amz-p mb-5 text-center">Nosso trabalho é feito prezando em agregar valor para a floresta em pé</p>
    </div>

    <div class="row gap-4">
      <div class="col d-flex flex-column justify-items-center align-items-center amz-secondary">
        <img src="/img/sustentavel.svg" alt="Sustentável" />
        <h1 class="h1-feat mt-3 mb-3">Sustentável</h1>
        <p class="amz-p text-center">Desfrute de nutrição sustentável com nosso suplemento à base de cariru, cultivado sem desmatamento.</p>
      </div>
      <div class="col d-flex flex-column justify-items-center align-items-center amz-secondary">
        <img src="/img/resiliente.svg" alt="Resiliente" />
        <h1 class="h1-feat mt-3 mb-3">Resiliente</h1>
        <p class="amz-p text-center">Experimente a resiliência da Amazônia com nosso suplemento de cariru, tenha um estilo de vida ativo.</p>
      </div>
      <div class="col d-flex flex-column justify-items-center align-items-center amz-secondary">
        <img src="/img/poderoso.svg" alt="Poderoso" />
        <h1 class="h1-feat mt-3 mb-3">Poderoso</h1>
        <p class="amz-p text-center">Descubra o poder nutricional do cariru, uma planta amazônica rica em nutrientes.</p>
      </div>
    </div>
  </div>
</div>


<!-- Product Section -->
<div class="container-md pt-4 mt-5 mb-5" id="product">
  <div class="row flex-sm-row flex-column">
    <!-- Texto do Produto -->
    <div class="col-md-6 mb-4 mb-md-0">
      <div class="text-start amz-primary mb-3">
        <h1 class="h1-black">O produto</h1>
        <h1 class="h1-light">Revolucionário</h1>
        <p class="amz-primary amz-p">
          Apresentamos um suplemento proteico vegetal de cariru, uma planta nativa da Amazônia considerada uma PANC (Planta Alimentícia Não Convencional). O cariru é reconhecido por suas ricas propriedades nutricionais, tornando-o uma opção superior para quem busca uma suplementação proteica de qualidade. Nosso produto não só oferece os benefícios essenciais de proteína, mas também é uma escolha ambientalmente responsável.
          <br /><br />
          Com um modelo de negócio B2B2C e venda direta, estamos prontos para atender tanto empresas quanto consumidores finais, contribuindo para um mercado de suplementos proteicos plant-based que deve atingir US$ 17,4 bilhões até 2027, crescendo a uma taxa anual composta de 8,4%.
        </p>
      </div>
    </div>

    <!-- Bento Grid para Desktop -->
    <div class="col-md-6 d-none d-md-grid bento-grid">
      <img src="/img/product3.svg" alt="Imagem do produto 1" class="img-fluid bento-item bento-item-1">
      <img src="/img/product2.svg" alt="Imagem do produto 2" class="img-fluid bento-item bento-item-2">
      <img src="/img/product1.svg" alt="Imagem do produto 3" class="img-fluid bento-item bento-item-3">
    </div>

    <!-- Bento Grid para Mobile (com 3 imagens) -->
    <div class="col-12 d-md-none bento-grid-mobile">
      <img src="/img/product3.svg" alt="Imagem do produto 1" class="img-fluid bento-item-mobile bento-item-mobile-1">
      <img src="/img/product2.svg" alt="Imagem do produto 2" class="img-fluid bento-item-mobile bento-item-mobile-2">
      <img src="/img/product1.svg" alt="Imagem do produto 3" class="img-fluid bento-item-mobile bento-item-mobile-3">
    </div>
  </div>
</div>

<!-- Contact Section-->
<div class="container-md pt-4" id="contact">
  <div id="heroFooter" class="amz-bg-primary amz-br amz-secondary d-flex flex-column-reverse flex-md-row">
    <div class="col d-flex justify-content-center py-0 py-sm-5">
      <form id="contactForm" class="d-flex justify-content-center flex-column px-sm-5 px-3 mb-4 mb-sm-0">
        <div class="mb-3 row">
          <div class="col">
            <input type="text" class="form-control" name="user_name" placeholder="Nome" required />
          </div>
          <div class="col">
            <input type="text" class="form-control" name="user_lastname" placeholder="Sobrenome" required />
          </div>
        </div>
        <div class="mb-3">
          <input type="email" class="form-control" name="user_email" placeholder="Email" required />
        </div>
        <div class="mb-3">
          <textarea class="form-control" name="message" placeholder="Mensagem" rows="6" required></textarea>
        </div>
        <input class="btn amz-btn-primary amz-bg-secondary amz-primary amz-p" type="submit" value="Enviar" />
        <p id="statusMessage"></p>
      </form>
    </div>
    <div class="col d-flex flex-column justify-content-center mt-4 mb-4 mb-sm-0 mt-sm-0 px-3 align-items-center">
      <div class="text-start">
        <h1 class="h1-black">Fale conosco</h1>
        <h1 class="h1-light">entre em contato</h1>
        <p class="amz-p">Queremos ouvir você para proporcionarmos a melhor experiência</p>
      </div>
    </div>
  </div>
</div>

